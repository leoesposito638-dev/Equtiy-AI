# Base URL of a deployed Equity AI backend (see ../backend).
# Leave unset to run the app in demo mode against local fixtures.
#
# Fastest way to see REAL (non-fixture) numbers: run the backend's zero-setup
# local dev server (`npm run dev:local` in ../backend — no database,
# no npm install even, see its README) and point this at it:
#   VITE_API_BASE_URL=http://localhost:4000
# Note: /companies/:id/analysis will return an empty thesis in that mode —
# it has no ANTHROPIC_API_KEY to call. Everything else (scores, financials,
# changes, alerts) is genuinely computed by the real scoring engine.
VITE_API_BASE_URL=

# Sent as x-user-id on user-scoped endpoints (/watchlists, /alerts) until
# real auth exists on the backend — see ../backend/src/api/auth.ts.
# Must be UUID-shaped: alerts.user_id / watchlists.user_id are `uuid not
# null` columns with no app-level format check, so a non-UUID value here
# (e.g. the literal string "demo-user") makes every /alerts and /watchlists
# request fail with a 500 from Postgres's own type cast.
VITE_DEMO_USER_ID=00000000-0000-0000-0000-000000000001
