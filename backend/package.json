{
  "name": "equity-ai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Equity AI — database, calculation, scoring, AI-analysis, change-detection, and API layer.",
  "type": "commonjs",
  "scripts": {
    "test": "vitest run",
    "dev": "ts-node src/api/server.ts",
    "dev:local": "ts-node --transpile-only src/localDev/server.ts",
    "test:fmp-nvda": "ts-node --transpile-only src/localDev/testFmpNvidiaRevenue.ts",
    "calc:growth-nvda": "ts-node --transpile-only src/localDev/calculateNvidiaGrowthMetrics.ts",
    "verify:scoring-repo-nvda": "ts-node --transpile-only src/localDev/verifyGrowthScoringRepoNvda.ts",
    "build": "tsc -p tsconfig.json",
    "migrate": "echo 'Run schema/*.sql in order against your Postgres/Supabase instance (e.g. psql $DATABASE_URL -f schema/001_core_tables.sql ...)'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
