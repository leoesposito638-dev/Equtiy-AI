# Database (Supabase/Postgres)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI service
ANTHROPIC_API_KEY=

# Internal/admin endpoint auth (service-to-service, separate from user auth)
INTERNAL_SERVICE_TOKEN=

# Financial data vendor(s) — add whichever provider(s) you implement adapters for
# FMP_API_KEY is read by src/providers/adapters/fmpAdapter.ts, wired in
# src/providers/registry.ts. Currently powers income-statement revenue only
# (see src/localDev/testFmpNvidiaRevenue.ts for the first integration test).
FMP_API_KEY=
# POLYGON_API_KEY=

# SEC EDGAR requires an identifying User-Agent on every request (its fair-
# access policy), not an API key. Format: "AppName contact-email-or-url"
# (e.g. "EquityAI research@yourdomain.com"). Read by
# src/providers/adapters/secEdgarAdapter.ts. NOT wired into
# src/providers/registry.ts yet (Milestone 7B is standalone-adapter-only —
# see src/localDev/verifySecEdgarAdapter.ts for the live verification script).
SEC_EDGAR_USER_AGENT=
